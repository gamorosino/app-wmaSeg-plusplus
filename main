#!/bin/bash
#PBS -l nodes=1:ppn=8,vmem=64gb,walltime=48:00:00
#PBS -N wmaSeg-python

[ -z "$FREESURFER_LICENSE" ] && echo "Please set FREESURFER_LICENSE in .bashrc" && exit 1
echo $FREESURFER_LICENSE > license.txt

set -e
set -x

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

# 1. Convert FreeSurfer parcellation to NIfTI (skip if already done)
if [ ! -f aparc.a2009s+aseg.nii.gz ]; then
    echo "Converting aparc.a2009s+aseg to NIfTI..."
    singularity exec -e \
        -B "$(pwd)/license.txt:/usr/local/freesurfer/license.txt" \
        docker://brainlife/freesurfer-mini:6.0.1 \
        ./convertaseg.sh
fi

# 2. Run white matter segmentation (Python port of wma_tools)
echo "Running white matter segmentation..."
singularity exec -e \
    docker://brainlife/dipy:1.1.1 \
    python3 main.py

if [ ! -s classification/classification.mat ]; then
    echo "ERROR: classification/classification.mat is missing or empty"
    exit 1
fi

# 3. Generate VTK surfaces from parcellation
echo "Generating VTK surfaces..."
singularity exec -e \
    docker://brainlife/pythonvtk:1.1 \
    ./freesurfer2vtks.py

echo "All done."
